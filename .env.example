# Nitanics local development defaults
#
# `bun run neo4j:ensure` writes app-specific .env files automatically.
# Keep this file as the public reference for GitHub users.
# Export MT_NEO4J_* in the shell; the helper does not read this root file.

MT_NEO4J_IMAGE=neo4j:5.26.0-community
MT_NEO4J_CONTAINER=memorytonic-neo4j
MT_NEO4J_HOST=127.0.0.1
MT_NEO4J_BOLT_PORT=7687
MT_NEO4J_HTTP_PORT=7474
MT_NEO4J_USER=neo4j
MT_NEO4J_PASSWORD=12345678
MT_NEO4J_DATABASE=memorytonic

VITE_NEO4J_URI=bolt://127.0.0.1:7687
VITE_NEO4J_USER=neo4j
VITE_NEO4J_PASSWORD=12345678
VITE_NEO4J_DATABASE=memorytonic

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_HTTP=http://127.0.0.1:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=memorytonic
